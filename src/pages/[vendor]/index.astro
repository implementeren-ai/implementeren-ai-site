---
import { render } from 'astro:content';
import VendorLayout from '../../layouts/VendorLayout.astro';
import { getPublished } from '../../lib/content';
import { itemListNode } from '../../lib/schema';
import { soortLabels, vendorNamen } from '../../data/vendors.mjs';

export async function getStaticPaths() {
  // De vendor-landing bestaat alleen als de index-entry live is: geen live
  // src/content/vendors/<vendor>/index.md, geen /<vendor> (geen lege hub).
  // De glob-loader strips het /index-slot, dus de landing heeft id '<vendor>'.
  const landings = (await getPublished('vendors')).filter((e) => !e.id.includes('/'));
  return landings.map((page) => {
    if (page.id !== page.data.vendor) {
      throw new Error(`vendors/${page.id}: het bestand hoort in src/content/vendors/${page.data.vendor}/index.md (vendor-veld en mapnaam moeten gelijk zijn)`);
    }
    return {
      params: { vendor: page.data.vendor },
      props: { entry: page },
    };
  });
}

const { entry } = Astro.props;
const vendor = entry.data.vendor;
const pagePath = `/${vendor}`;
const { Content, headings } = await render(entry);

// De andere live pagina's van deze vendor, als kaarten onder het artikel plus
// dezelfde lijst als ItemList in het schema (zelfde patroon als /prijs).
const andere = (await getPublished('vendors'))
  .filter((e) => e.data.vendor === vendor && e.id !== entry.id)
  .sort((a, b) => b.data.priority - a.data.priority || a.data.title.localeCompare(b.data.title));
const schemaNodes = andere.length > 0
  ? [itemListNode(pagePath, andere.map((a) => ({ url: `/${a.id}`, naam: a.data.title })))]
  : [];
---
<VendorLayout entry={entry} pagePath={pagePath} hub koppen={headings} schemaNodes={schemaNodes}>
  <Content />
  {andere.length > 0 && (
    <section slot="na-artikel" class="v2-artikel-na">
      <h2 class="text-[length:var(--text-h2)]">Meer over {vendorNamen[vendor]}</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {andere.map((a) => (
          <a href={`/${a.id}`} class="no-underline block rounded-lg border border-lijn bg-papier p-6 card-shadow">
            <span class="v2-casekaart-meta">{soortLabels[a.data.soort]}</span>
            <h3 class="font-serif text-xl font-bold text-inkt">{a.data.title}</h3>
            <p class="mt-2 text-sm text-inkt-zacht">{a.data.metaDescription}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent-donkerst">Lees de gids<span class="cta-arrow">&rarr;</span></span>
          </a>
        ))}
      </div>
    </section>
  )}
</VendorLayout>
