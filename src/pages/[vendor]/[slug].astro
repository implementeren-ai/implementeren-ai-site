---
import { render } from 'astro:content';
import VendorLayout from '../../layouts/VendorLayout.astro';
import { getVendorPaginas } from '../../lib/content';
import { vendorPad } from '../../data/vendors.mjs';

export async function getStaticPaths() {
  // Elke gebouwde vendor-entry behalve de landing: chatgpt/prijs.md -> /chatgpt/prijs.
  // Gebouwd = live, niet geschrapt en de schakelaar aan (src/data/livegang.mjs).
  // De glob-loader strips een /index-slot van het id, dus index.md heeft id '<vendor>'
  // en wordt op /<vendor> gerenderd (./index.astro); alles mét een '/' hoort hier.
  // Verhuisde vergelijkingen (vendorVergelijkingen in src/data/vendors.mjs) renderen op
  // /vergelijken/<vendor>-vs-chatgpt (src/pages/vergelijken/[slug].astro), nooit hier.
  const pages = (await getVendorPaginas()).filter((e) => e.id.includes('/') && vendorPad(e.id) === `/${e.id}`);
  return pages.map((page) => {
    const delen = page.id.split('/');
    if (delen.length !== 2 || delen[0] !== page.data.vendor) {
      throw new Error(`vendors/${page.id}: het bestand hoort in src/content/vendors/${page.data.vendor}/<slug>.md (vendor-veld en mapnaam moeten gelijk zijn)`);
    }
    return {
      params: { vendor: delen[0], slug: delen[1] },
      props: { entry: page },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<VendorLayout entry={entry} pagePath={vendorPad(entry.id)} koppen={headings}>
  <Content />
</VendorLayout>
