---
import { getEntry, render } from 'astro:content';
import BasisLayout from '../layouts/BasisLayout.astro';
import CtaBlok from '../components/CtaBlok.astro';
import DienstKop from '../components/DienstKop.astro';
import DienstBeeld from '../components/DienstBeeld.astro';
import ArtikelInhoud from '../components/ArtikelInhoud.astro';
import { dienstNode, dienstId } from '../lib/schema';

const dienst = await getEntry('diensten', 'retainer');
if (!dienst) throw new Error('Diensten-entry retainer ontbreekt');
const { Content, headings } = await render(dienst);
const beschrijving = 'Claude Compagnon: een abonnement op Camiel. Onbeperkt toegang via Teams-chat en twee sessies per maand, vanaf €2.500 per maand.';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Claude Compagnon', url: dienst.data.pad }];
---
<BasisLayout
  titel={dienst.data.titleTag ?? dienst.data.titel}
  beschrijving={beschrijving}
  pad={dienst.data.pad}
  schema={{
    breadcrumbs,
    hoofdonderwerp: dienstId(dienst.data.pad),
    nodes: [dienstNode({ pad: dienst.data.pad, naam: dienst.data.titel, beschrijving, serviceType: 'Doorlopende Claude-begeleiding', aanbod: { naam: dienst.data.titel, prijsTekst: dienst.data.prijs, url: dienst.data.pad } })],
  }}
>
  <article class="v2-artikel">
    <DienstKop
      breadcrumbs={breadcrumbs}
      label={dienst.data.ondertitel}
      h1={dienst.data.h1 ?? dienst.data.titel}
      feiten={[
        { term: 'Prijs', waarde: dienst.data.prijs },
        { term: 'Termijn', waarde: dienst.data.duur },
      ]}
    >
      <DienstBeeld slot="beeld" soort="compagnon" />
    </DienstKop>

    <div class="v2-artikel-raster">
      <ArtikelInhoud soort="zijkant" koppen={headings} />
      <div class="v2-artikel-tekst">
        <ArtikelInhoud soort="mobiel" koppen={headings} />
        <div class="prose prose-lg max-w-none v2-prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
  <CtaBlok
    kop="Waar begin je?"
    tekst="De Compagnon is de derde stap, na de Readiness Scan en Claude in 30 dagen. Doe eerst de gratis AI-check, dan weet je binnen twee minuten of het zin heeft voor je team."
    link="/ai-enablement-scan"
    linkTekst="Doe de gratis AI-check"
  />
</BasisLayout>
