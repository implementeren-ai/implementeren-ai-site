---
// Artikel-layout voor de vendor-secties (/chatgpt, /gemini, /copilot). Zelfde opbouw als
// VergelijkingLayout; hub-stand (de /<vendor>-landing rendert de index-entry) en
// schemaNodes zoals PrijsLayout. Bij claudeSibling komt er een "Vergelijk met Claude"-
// linkblok onder het kort antwoord.
import BasisLayout from './BasisLayout.astro';
import { seoVoorEntry, type Node } from '../lib/schema';
import { getEntry } from 'astro:content';
import { isPublished } from '../lib/content';
import { vendorNamen, soortLabels } from '../data/vendors.mjs';
import KortAntwoord from '../components/KortAntwoord.astro';
import ArtikelBeeld from '../components/ArtikelBeeld.astro';
import ArtikelMeta from '../components/ArtikelMeta.astro';
import AdviesDisclaimer from '../components/AdviesDisclaimer.astro';
import Broodkruimel from '../components/Broodkruimel.astro';
import AuthorBio from '../components/AuthorBio.astro';
import FaqSectie from '../components/FaqSectie.astro';
import BronnenBlok from '../components/BronnenBlok.astro';
import CtaStrook from '../components/CtaStrook.astro';
import GerelateerdeLinks from '../components/GerelateerdeLinks.astro';
import ArtikelInhoud from '../components/ArtikelInhoud.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  entry: {
    data: {
      title: string;
      titleTag: string;
      metaDescription: string;
      h1: string;
      schemaTypes: string[];
      author: 'camiel';
      internalLinks: string[];
      publishDate: Date | null;
      updatedDate: Date | null;
      reviewedBy: string | null;
      reviewedDate: Date | null;
      disclaimer: 'juridisch' | 'fiscaal' | 'juridisch-fiscaal' | null;
      changelogLine: string | null;
      kortAntwoord: string | null;
      bronnen: Array<{ titel: string; url: string | null; geraadpleegd: string | null }>;
      faq: Array<{ question: string; answer: string }>;
      vendor: 'chatgpt' | 'gemini' | 'copilot';
      soort: 'landing' | 'prijs' | 'avg' | 'vergelijking' | 'howto';
      claudeSibling: string | null;
    };
    id: string;
  };
  pagePath: string;
  /** Koppen uit render(entry), voor de inhoudsopgave. */
  koppen?: MarkdownHeading[];
  /** true op /<vendor>: de index-entry gerenderd als landing. */
  hub?: boolean;
  // Extra schema-nodes van de pagina zelf, bv. de ItemList van de hub-kaarten.
  schemaNodes?: Node[];
}

const { entry, pagePath, hub = false, schemaNodes = [], koppen = [] } = Astro.props;
const { data } = entry;

const vendorNaam = vendorNamen[data.vendor];
const hubPad = `/${data.vendor}`;

// De kruimel naar /<vendor> mag er alleen staan als die hub ook echt gebouwd wordt
// (index-entry live, zie src/pages/[vendor]/index.astro); anders zou de broodkruimel
// naar een 404 wijzen.
// De landing heeft id '<vendor>' (de glob-loader strips het /index-slot).
const indexEntry = hub ? undefined : await getEntry('vendors', data.vendor);
const hubLive = hub || (indexEntry !== undefined && isPublished(indexEntry));
const breadcrumbs = hub
  ? [{ name: 'Home', url: '/' }, { name: vendorNaam, url: hubPad }]
  : hubLive
    ? [{ name: 'Home', url: '/' }, { name: vendorNaam, url: hubPad }, { name: data.title, url: pagePath }]
    : [{ name: 'Home', url: '/' }, { name: data.title, url: pagePath }];
const seo = seoVoorEntry({ pad: pagePath, sectie: vendorNaam, breadcrumbs, data });
const schema = { ...seo.schema, nodes: [...(seo.schema.nodes ?? []), ...schemaNodes] };
---
<BasisLayout titel={data.titleTag} beschrijving={data.metaDescription} pad={pagePath} schema={schema} artikel={seo.artikel}>
  <article class="v2-artikel">
    <div class="v2-voortgang" aria-hidden="true"></div>
    <header class="v2-artikel-kop">
      <div class="v2-artikel-kop-binnen">
        <Broodkruimel items={breadcrumbs} />
        <span class="v2-chip">
          {soortLabels[data.soort]}
        </span>
        <h1 class="v2-artikel-h1">{data.h1}</h1>
        <ArtikelMeta publishDate={data.publishDate} updatedDate={data.updatedDate} author={data.author} reviewedBy={data.reviewedBy} reviewedDate={data.reviewedDate} disclaimer={data.disclaimer} />
      </div>
    </header>

    <div class="v2-artikel-raster">
      <ArtikelInhoud soort="zijkant" koppen={koppen} faq={data.faq.length > 0} />
      <div class="v2-artikel-tekst">
        {data.disclaimer && <AdviesDisclaimer soort={data.disclaimer} />}

        <ArtikelBeeld collectie="vendors" id={entry.id.replace('/', '-')} />

        <KortAntwoord tekst={data.kortAntwoord} stand={data.updatedDate ?? data.publishDate} />

        {data.claudeSibling && (
          <aside class="card-shadow rounded-xl border border-lijn bg-white p-5 my-8">
            <p class="m-0 font-serif text-lg font-bold text-inkt">Vergelijk met Claude</p>
            <p class="mt-2 mb-0 text-sm text-inkt-zacht">Wij zetten {vendorNaam} en Claude naast elkaar voor hetzelfde werk, met prijs en AVG erbij.</p>
            <a href={data.claudeSibling} class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-accent-diep no-underline">Lees de vergelijking<span class="cta-arrow">&rarr;</span></a>
          </aside>
        )}

        <ArtikelInhoud soort="mobiel" koppen={koppen} faq={data.faq.length > 0} />

        <div class="prose prose-lg max-w-none v2-prose">
          <slot />
        </div>

        <BronnenBlok bronnen={data.bronnen} />

        {data.faq.length > 0 && <FaqSectie items={data.faq} />}

        <AuthorBio author={data.author} />
      </div>
    </div>
  </article>
  <slot name="na-artikel" />

  <div class="v2-artikel-na">
    <CtaStrook dienst="consultant" />
    <GerelateerdeLinks links={data.internalLinks} />
  </div>
</BasisLayout>
