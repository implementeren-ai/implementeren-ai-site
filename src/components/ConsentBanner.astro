---
// Toestemmingsbanner (AVG/ePrivacy). Niet-modaal: geen overlay, geen scroll-lock, geen
// focus-trap. Staat standaard op hidden, dus zonder JS verschijnt hij niet en draait er
// niets optioneels. Sluiten (kruisje of Escape) verbergt hem alleen voor deze pageview en
// slaat niets op: analyse blijft uit en de vraag komt op de volgende pagina terug. De logica staat in src/scripts/consent.ts; de footerknop
// "Privacy-instellingen" (data-consent-open) opent de instellingen opnieuw.
---
<aside id="iai-consent" class="iai-consent" aria-label="Privacy-keuze" hidden>
  <h2 class="iai-consent-titel" id="iai-consent-titel" tabindex="-1">Even over je privacy</h2>
  <p class="iai-consent-tekst">
    Deze site zet geen cookies en maakt geen profiel van je.
    Mogen we, als je de AI-check invult, ook meesturen welke pagina's je hier bekeek? <a href="/privacy">Meer in de privacyverklaring</a>.
  </p>

  <div id="iai-consent-instellingen" class="iai-consent-instellingen" hidden>
    <div class="iai-consent-categorie">
      <input type="checkbox" id="iai-consent-noodzakelijk" checked disabled aria-describedby="iai-consent-noodzakelijk-uitleg" />
      <div>
        <label for="iai-consent-noodzakelijk">Noodzakelijk <span class="iai-consent-altijd">(altijd aan)</span></label>
        <p id="iai-consent-noodzakelijk-uitleg">Onthoudt je keuze en meet via welk kanaal je binnenkwam, zonder een profiel van je te maken.</p>
      </div>
    </div>
    <div class="iai-consent-categorie">
      <input type="checkbox" id="iai-consent-analyse" aria-describedby="iai-consent-analyse-uitleg" />
      <div>
        <label for="iai-consent-analyse">Analyse: bekeken pagina's meesturen</label>
        <p id="iai-consent-analyse-uitleg">Verstuur je de AI-check, dan gaat de lijst met pagina's die je in dit bezoek bekeek mee met je inzending. Zo zien we wat je al gelezen hebt. Staat standaard uit.</p>
      </div>
    </div>
  </div>

  <div class="iai-consent-knoppen">
    <button type="button" class="iai-consent-knop iai-consent-knop--voorkeur" data-consent="minimaal">Alleen noodzakelijk</button>
    <button type="button" class="iai-consent-knop" data-consent="alles" id="iai-consent-alles">Alles toestaan</button>
    <button type="button" class="iai-consent-knop" data-consent="opslaan" id="iai-consent-opslaan" hidden>Keuze opslaan</button>
    <button type="button" class="iai-consent-link" id="iai-consent-toggle" aria-expanded="false" aria-controls="iai-consent-instellingen">Instellingen</button>
  </div>
  {/* Sluitknop staat achteraan in de DOM, zodat de keuzeknoppen eerst aan de beurt zijn; visueel rechtsboven. */}
  <button type="button" class="iai-consent-sluit" id="iai-consent-sluit" aria-label="Melding sluiten"><span aria-hidden="true">×</span></button>
</aside>

<style>
  .iai-consent {
    position: fixed;
    z-index: 70;
    left: 16px;
    right: 16px;
    bottom: 16px;
    max-width: 30rem;
    margin-inline: auto;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 20px;
    border: 1px solid var(--color-lijn);
    border-radius: 16px;
    background: #fff;
    color: var(--color-inkt);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.5;
    box-shadow: 0 18px 40px -18px rgba(35, 38, 29, .45);
    animation: iai-consent-in .25s var(--ease-out-soft);
  }
  .iai-consent[hidden] { display: none; }
  @media (min-width: 640px) {
    .iai-consent { left: 24px; right: 24px; bottom: 24px; }
  }
  @keyframes iai-consent-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .iai-consent { animation: none; }
  }
  .iai-consent-titel {
    margin: 0 0 6px;
    padding-right: 36px;
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  /* Focus na openen via de footer: subtiel, maar zichtbaar. */
  .iai-consent-titel:focus { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 4px; }
  .iai-consent-sluit {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-inkt-zacht);
    font: inherit;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  .iai-consent-sluit:hover { background: var(--color-papier); color: var(--color-inkt); }
  .iai-consent-tekst { margin: 0; color: var(--color-inkt-zacht); }
  .iai-consent a { color: var(--color-accent-diep); text-decoration: underline; text-underline-offset: 2px; }
  .iai-consent a:hover { color: var(--color-accent-donkerst); }

  .iai-consent-instellingen { margin-top: 14px; display: grid; gap: 10px; }
  .iai-consent-instellingen[hidden] { display: none; }
  .iai-consent-categorie {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px;
    border: 1px solid var(--color-lijn);
    border-radius: 12px;
    background: var(--color-papier);
  }
  .iai-consent-categorie input {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    accent-color: var(--color-accent-diep);
  }
  .iai-consent-categorie input:focus-visible { outline: 2px solid var(--color-inkt); outline-offset: 2px; }
  .iai-consent-categorie label { font-weight: 600; color: var(--color-inkt); }
  .iai-consent-categorie p { margin: 2px 0 0; font-size: 14px; color: var(--color-inkt-zacht); }
  .iai-consent-altijd { font-weight: 400; color: var(--color-inkt-zacht); }

  /* De twee keuzeknoppen zijn bewust gelijk van vorm, breedte en gewicht: naast elkaar in
     twee gelijke kolommen, of op smalle schermen allebei over de volle breedte. */
  .iai-consent-knoppen { margin-top: 16px; display: grid; grid-template-columns: 1fr; gap: 8px; }
  @media (min-width: 420px) {
    .iai-consent-knoppen { grid-template-columns: 1fr 1fr; }
  }
  .iai-consent-knop {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--color-inkt);
    border-radius: 999px;
    background: #fff;
    color: var(--color-inkt);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .2s;
  }
  .iai-consent-knop[hidden] { display: none; }
  .iai-consent-knop:hover { background: var(--color-papier); }
  /* De vriendelijke keuze valt het meest op: olijf, zoals de hoofdknop van de site. */
  .iai-consent-knop--voorkeur {
    border-color: var(--color-accent-diep);
    background: var(--color-accent-diep);
    color: var(--color-papier);
  }
  .iai-consent-knop--voorkeur:hover { background: var(--color-accent-donkerst); }
  .iai-consent-link {
    grid-column: 1 / -1;
    justify-self: start;
    min-height: 44px;
    padding: 0 6px;
    border: 0;
    background: none;
    color: var(--color-inkt-zacht);
    font: inherit;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  .iai-consent-link:hover { color: var(--color-inkt); }
  .iai-consent-knop:focus-visible,
  .iai-consent-link:focus-visible,
  .iai-consent-sluit:focus-visible,
  .iai-consent a:focus-visible { outline: 2px solid var(--color-inkt); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .iai-consent-knop { transition: none; }
  }
</style>

<script>
  import { bewaarToestemming, CONSENT_EVENT, leesToestemming, type Toestemming } from '../scripts/consent';

  const banner = document.getElementById('iai-consent');
  const instellingen = document.getElementById('iai-consent-instellingen');
  const toggle = document.getElementById('iai-consent-toggle');
  const titel = document.getElementById('iai-consent-titel');
  const alles = document.getElementById('iai-consent-alles');
  const opslaan = document.getElementById('iai-consent-opslaan');
  const analyse = document.getElementById('iai-consent-analyse') as HTMLInputElement | null;
  // Waar de focus heen gaat na een keuze, als de banner via de footerknop werd geopend.
  let terugNaar: HTMLElement | null = null;
  // True als de banner bewust is geopend (footer of API), false als hij vanzelf verscheen.
  let handmatig = false;

  function toonInstellingen(open: boolean) {
    if (!instellingen || !toggle) return;
    instellingen.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? 'Instellingen verbergen' : 'Instellingen';
    if (alles) alles.hidden = open;
    if (opslaan) opslaan.hidden = !open;
    // Het vinkje toont de huidige keuze; zonder keuze staat het uit.
    if (open && analyse) analyse.checked = leesToestemming()?.analytics === true;
  }

  function open(metInstellingen: boolean, bewust: boolean) {
    if (!banner) return;
    handmatig = bewust;
    banner.hidden = false;
    toonInstellingen(metInstellingen);
  }

  // Ook gebruikt voor het kruisje en Escape: verbergen zonder iets op te slaan.
  function sluit() {
    if (!banner) return;
    banner.hidden = true;
    handmatig = false;
    toonInstellingen(false);
    if (terugNaar && document.contains(terugNaar)) terugNaar.focus();
    terugNaar = null;
  }

  function kies(analytics: boolean) {
    bewaarToestemming(analytics);
    sluit();
  }

  banner?.addEventListener('click', (e) => {
    const knop = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-consent]');
    if (!knop) return;
    const soort = knop.dataset.consent;
    if (soort === 'minimaal') kies(false);
    else if (soort === 'alles') kies(true);
    else if (soort === 'opslaan') kies(analyse?.checked === true);
  });

  document.getElementById('iai-consent-sluit')?.addEventListener('click', sluit);

  // Escape sluit de melding als de focus erin staat of nergens in het bijzonder.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !banner || banner.hidden) return;
    const actief = document.activeElement;
    if (!actief || actief === document.body || banner.contains(actief)) sluit();
  });

  // Keuze gewijzigd, ook in een ander tabblad: het vinkje volgen, en een vanzelf
  // verschenen banner verbergen zodra er een keuze is.
  window.addEventListener(CONSENT_EVENT, () => {
    if (!banner || banner.hidden) return;
    const keuze = leesToestemming();
    if (analyse) analyse.checked = keuze?.analytics === true;
    if (keuze && !handmatig) sluit();
  });

  toggle?.addEventListener('click', () => {
    toonInstellingen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Footerknop(pen) "Privacy-instellingen": alleen zichtbaar als JS draait.
  document.querySelectorAll<HTMLElement>('[data-consent-open-scheiding]').forEach((el) => (el.hidden = false));
  document.querySelectorAll<HTMLButtonElement>('[data-consent-open]').forEach((knop) => {
    knop.hidden = false;
    knop.addEventListener('click', () => {
      terugNaar = knop;
      open(true, true);
      titel?.focus();
    });
  });

  // Zie de uitleg bovenin src/scripts/consent.ts.
  const api = {
    get: (): Toestemming | null => leesToestemming(),
    open: () => {
      open(true, true);
      titel?.focus();
    },
  };
  (window as unknown as { iaiConsent: typeof api }).iaiConsent = api;

  // Nog geen (geldige) keuze: eerste laag tonen. Er wordt niets aangenomen.
  if (leesToestemming() === null) open(false, false);
</script>
